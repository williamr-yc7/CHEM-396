\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Structure of the quenched solid}{5}{subsection.4.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The quenched solid at 300~K. $r_1$, $r_{\min }$ and $r_2$ are the first peak, first minimum and second peak of $g(r)$. Coordination uses a 2.85~\r A{} cutoff and ``defects'' is the fraction of atoms that are not fourfold, both over the last 50~ps. MSD is the plateau value. Reference values: bond length 2.35~\r A{} in c-Si and mean coordination 3.88 and density 2.28~g/cm$^3$ in experiment; $q = 0.99$ and $0.49$ are this work's own crystal and liquid values, not literature.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:quench}{{2}{5}{The quenched solid at 300~K. $r_1$, $r_{\min }$ and $r_2$ are the first peak, first minimum and second peak of $g(r)$. Coordination uses a 2.85~\AA {} cutoff and ``defects'' is the fraction of atoms that are not fourfold, both over the last 50~ps. MSD is the plateau value. Reference values: bond length 2.35~\AA {} in c-Si and mean coordination 3.88 and density 2.28~g/cm$^3$ in experiment; $q = 0.99$ and $0.49$ are this work's own crystal and liquid values, not literature}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: radial distribution functions of the four quenched structures at 300~K, over the last 50~ps. Right: mean squared displacement over the full 150~ps equilibration.}}{5}{figure.1}\protected@file@percent }
