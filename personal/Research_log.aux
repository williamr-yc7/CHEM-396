\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Coordination breakdown of the quenched solid at 300~K, using a 2.85~\r A{} bond cutoff over the last 50~ps of each equilibration. Entries below $0.1\%$ are omitted. \texttt  {pruned\_1} is both the densest run (Table~\ref {tab:quench_structural}) and the most overcoordinated, consistent with closer packing forcing additional neighbours inside the cutoff.}}{44}{table.caption.57}\protected@file@percent }
\newlabel{tab:defect_breakdown}{{13}{44}{Coordination breakdown of the quenched solid at 300~K, using a 2.85~\AA {} bond cutoff over the last 50~ps of each equilibration. Entries below $0.1\%$ are omitted. \texttt {pruned\_1} is both the densest run (Table~\ref {tab:quench_structural}) and the most overcoordinated, consistent with closer packing forcing additional neighbours inside the cutoff}{table.caption.57}{}}
