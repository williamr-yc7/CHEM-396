\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces The liquid at 2500~K for each potential, over the final 30~ps of each hold. $r_1$ and $r_{\min }$ are the first peak and first minimum of $g(r)$; the second peak is a shoulder of $g(r) \approx 1.02$ near 4~\r A{} and too weak to locate reliably. $\bar  {n}$ uses a 3.15~\r A{} cutoff, $D$ comes from the Einstein relation, $\rho $ from the mean box volume. The \texttt  {26.almtp} hold is 0.4~ns, so its dynamical statistics are correspondingly poorer.}}{36}{table.caption.21}\protected@file@percent }
\newlabel{tab:hold_structural}{{9}{36}{The liquid at 2500~K for each potential, over the final 30~ps of each hold. $r_1$ and $r_{\min }$ are the first peak and first minimum of $g(r)$; the second peak is a shoulder of $g(r) \approx 1.02$ near 4~\AA {} and too weak to locate reliably. $\bar {n}$ uses a 3.15~\AA {} cutoff, $D$ comes from the Einstein relation, $\rho $ from the mean box volume. The \texttt {26.almtp} hold is 0.4~ns, so its dynamical statistics are correspondingly poorer}{table.caption.21}{}}
