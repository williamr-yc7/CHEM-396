\@writefile{lot}{\contentsline {table}{\numberline {15}{\ignorespaces Coordination breakdown of the quenched solid at 300~K, using a 2.85~\r A{} bond cutoff over the last 50~ps of each equilibration. Entries below $0.1\%$ are omitted. \texttt  {pruned\_1} is both the densest run (Table~\ref {tab:quench_structural}) and the most overcoordinated, consistent with closer packing forcing additional neighbours inside the cutoff.}}{40}{table.caption.68}\protected@file@percent }
