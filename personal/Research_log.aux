\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.3.2}Structural Comparison}{40}{subsubsection.4.3.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces The quenched solid at 300~K. $r_1$, $r_{\min }$ and $r_2$ are the first peak, first minimum and second peak of $g(r)$. Coordination $\bar  {n}$ uses a 2.85~\r A{} cutoff, and ``defects'' is the fraction of atoms that are not fourfold. These columns are computed over the last 50~ps of each equilibration. The MSD column is the plateau value, averaged past 10~ps of the full 150~ps block, since the MSD is measured relative to the first frame of whatever window it is given. No diffusion coefficient is quoted: the MSD is flat, so $D$ is not measurable.}}{40}{table.caption.27}\protected@file@percent }
\newlabel{tab:quench_structural}{{12}{40}{The quenched solid at 300~K. $r_1$, $r_{\min }$ and $r_2$ are the first peak, first minimum and second peak of $g(r)$. Coordination $\bar {n}$ uses a 2.85~\AA {} cutoff, and ``defects'' is the fraction of atoms that are not fourfold. These columns are computed over the last 50~ps of each equilibration. The MSD column is the plateau value, averaged past 10~ps of the full 150~ps block, since the MSD is measured relative to the first frame of whatever window it is given. No diffusion coefficient is quoted: the MSD is flat, so $D$ is not measurable}{table.caption.27}{}}
\citation{zongo2025}
\newlabel{fig:quench_hold_rdf}{{11a}{41}{Radial distribution function}{figure.caption.28}{}}
\newlabel{sub@fig:quench_hold_rdf}{{a}{41}{Radial distribution function}{figure.caption.28}{}}
\newlabel{fig:quench_hold_msd}{{11b}{41}{Mean square displacement}{figure.caption.28}{}}
\newlabel{sub@fig:quench_hold_msd}{{b}{41}{Mean square displacement}{figure.caption.28}{}}
\newlabel{fig:quench_hold_cn}{{11c}{41}{Coordination number}{figure.caption.28}{}}
\newlabel{sub@fig:quench_hold_cn}{{c}{41}{Coordination number}{figure.caption.28}{}}
\newlabel{fig:quench_hold_top}{{11d}{41}{Tetrahedral order parameter}{figure.caption.28}{}}
\newlabel{sub@fig:quench_hold_top}{{d}{41}{Tetrahedral order parameter}{figure.caption.28}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces The quenched solid at 300~K, over the last 50~ps of each run, except the MSD which uses the full 150~ps. The second peak of $g(r)$ at 3.88~\r A{} survives while the third is absent, which is what separates an amorphous network from a frozen liquid. The MSD is flat for all four, confirming the atoms vibrate rather than diffuse. Coordination peaks sharply at fourfold and the tetrahedral order parameter near $0.93$.}}{41}{figure.caption.28}\protected@file@percent }
\newlabel{fig:quench_hold_comparison}{{11}{41}{The quenched solid at 300~K, over the last 50~ps of each run, except the MSD which uses the full 150~ps. The second peak of $g(r)$ at 3.88~\AA {} survives while the third is absent, which is what separates an amorphous network from a frozen liquid. The MSD is flat for all four, confirming the atoms vibrate rather than diffuse. Coordination peaks sharply at fourfold and the tetrahedral order parameter near $0.93$}{figure.caption.28}{}}
